# Export these values in the process environment (the CLI does not load `.env`
# automatically). Required for SEC network access by backfill-sec --execute
# and by update-sec --cik-file ... --execute. Local XML normalization does not
# need this value. Identify the project and a monitored contact address; do not
# use a generic or blank User-Agent.
SEC_USER_AGENT=InsiderTurningEngine/0.1 (+you@example.com)

# Required by send-alerts --execute. Keep blank in this example and never
# commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
