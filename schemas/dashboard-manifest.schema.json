{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insider-turning.local/schemas/dashboard-manifest.schema.json",
  "title": "Dashboard publication manifest",
  "description": "Immutable, content-addressed description of one dashboard publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "runId",
    "asOf",
    "generatedAt",
    "status",
    "scoreVersion",
    "versions",
    "watermarks",
    "universe",
    "quality",
    "signals",
    "artifacts",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^mft_[A-Za-z0-9_-]{16,64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]{16,64}$"
    },
    "asOf": {
      "$ref": "#/$defs/instant"
    },
    "generatedAt": {
      "$ref": "#/$defs/instant"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "DEGRADED"
      ]
    },
    "scoreVersion": {
      "const": "scoring.v1"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoring",
        "stateModel",
        "canonicalSchema",
        "signalSchema"
      ],
      "properties": {
        "scoring": {
          "const": "scoring.v1"
        },
        "stateModel": {
          "const": "state.v1"
        },
        "canonicalSchema": {
          "const": "1.0.0"
        },
        "signalSchema": {
          "const": "1.0.0"
        }
      }
    },
    "watermarks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secAcceptedThrough",
        "marketSessionThrough",
        "fundamentalsAvailableThrough"
      ],
      "properties": {
        "secAcceptedThrough": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "marketSessionThrough": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "fundamentalsAvailableThrough": {
          "oneOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerCount",
        "activeTransactionCount",
        "signalCount"
      ],
      "properties": {
        "issuerCount": {
          "type": "integer",
          "minimum": 0
        },
        "activeTransactionCount": {
          "type": "integer",
          "minimum": 0
        },
        "signalCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signalReference"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileRecord"
      }
    }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "rateMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "rate",
        "threshold",
        "result"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "PASS"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "canonicalValid": {
                "const": true
              },
              "methodologyComplete": {
                "const": true
              },
              "benchmarkFresh": {
                "const": true
              },
              "issues": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "required": [
        "disposition",
        "canonicalValid",
        "methodologyComplete",
        "benchmarkFresh",
        "parseSuccess",
        "marketCoverage",
        "coreBranchCoverage",
        "issues"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "PASS",
            "DEGRADED",
            "BLOCKED"
          ]
        },
        "canonicalValid": {
          "type": "boolean"
        },
        "methodologyComplete": {
          "type": "boolean"
        },
        "benchmarkFresh": {
          "type": "boolean"
        },
        "parseSuccess": {
          "allOf": [
            {
              "$ref": "#/$defs/rateMeasurement"
            },
            {
              "type": "object",
              "properties": {
                "threshold": {
                  "const": 0.995
                }
              }
            }
          ]
        },
        "marketCoverage": {
          "allOf": [
            {
              "$ref": "#/$defs/rateMeasurement"
            },
            {
              "type": "object",
              "properties": {
                "threshold": {
                  "const": 0.9
                }
              }
            }
          ]
        },
        "coreBranchCoverage": {
          "allOf": [
            {
              "$ref": "#/$defs/rateMeasurement"
            },
            {
              "type": "object",
              "properties": {
                "threshold": {
                  "const": 0.85
                }
              }
            }
          ]
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        }
      }
    },
    "signalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "issuerCik",
        "ticker",
        "state",
        "totalScore",
        "uri",
        "contentHash"
      ],
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^sig_[A-Za-z0-9_-]{16,64}$"
        },
        "issuerCik": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,14}$"
        },
        "state": {
          "enum": [
            "FALLING",
            "INSIDER_ACCUMULATION",
            "BASE_FORMING",
            "EARLY_TURN",
            "CONFIRMED_TURN"
          ]
        },
        "totalScore": {
          "$ref": "#/$defs/score"
        },
        "uri": {
          "type": "string",
          "format": "uri-reference",
          "maxLength": 2000
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "contentHash",
        "mediaType"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SIGNAL_INDEX",
            "ALERT_INDEX",
            "QUALITY_REPORT",
            "SETTINGS_STATUS",
            "OTHER"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri-reference",
          "maxLength": 2000
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        }
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
